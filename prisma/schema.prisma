// Prisma schema for Conference Management Portal
// Using SQLite for prototype — switch to PostgreSQL for production:
//   provider = "postgresql"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ───

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean     @default(true)
  isSuspended  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  roles        UserRole[]
  participant  Participant?
  registrations Registration[]
  reviews      Review[]
  assignments  ReviewerAssignment[]
  auditLogs    AuditLog[]
  notifications Notification[]
  volunteers   Volunteer[]
}

model Role {
  id          String      @id @default(uuid())
  name        String      @unique // PARTICIPANT, REVIEWER, COMMITTEE_MEMBER, FINANCE_MANAGER, OPERATIONS_MANAGER, SUPER_ADMIN
  description String?
  users       UserRole[]
  permissions  RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique // e.g. "submissions.review", "finance.manage"
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─── Conference Configuration ───

model ConferenceSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

// ─── Participants & Registrations ───

model Participant {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution     String?
  department      String?
  category        String?  // UNDERGRADUATE, POSTGRADUATE, FACULTY, INDUSTRY, INTERNATIONAL, VIRTUAL, INVITED_SPEAKER
  attendanceMode  String?  // IN_PERSON, VIRTUAL, HYBRID
  bio             String?
  address         String?
  city            String?
  country         String?
  zipCode         String?
  designation      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  registrationId  String?  @unique // Generated registration ID like REG-2026-001
  registrations   Registration[]
  submissions      SubmissionAuthor[]
  submissions2      Submission[]
  attendance       Attendance[]
  certificates     Certificate[]
}

model Registration {
  id              String   @id @default(uuid())
  participantId   String?
  participant     Participant? @relation(fields: [participantId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  registrationId  String   @unique
  category        String
  attendanceMode   String
  feeAmount       Float
  discountAmount  Float    @default(0)
  taxAmount       Float    @default(0)
  totalAmount     Float
  status          String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED, EXEMPT
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        Payment[]
  refund          Refund?
  certificate     Certificate?
}

// ─── Fee Engine ───

model FeeRule {
  id              String   @id @default(uuid())
  category        String   @unique // UNDERGRADUATE, POSTGRADUATE, FACULTY, INDUSTRY, INTERNATIONAL, VIRTUAL, INVITED_SPEAKER
  standardFee     Float
  earlyBirdFee     Float
  earlyBirdEndDate DateTime?
  standardEndDate  DateTime?
  attendanceMode   String   @default("ALL") // ALL, IN_PERSON, VIRTUAL, HYBRID
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Discount {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  type        String   // PERCENTAGE, FIXED
  value       Float
  maxUses     Int?
  usedCount   Int      @default(0)
  validFrom   DateTime?
  validTo     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ─── Payments & Refunds ───

model Payment {
  id              String   @id @default(uuid())
  registrationId  String
  registration    Registration @relation(fields: [registrationId], references: [id])
  transactionRef  String   @unique
  amount          Float
  status          String   @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  method          String   @default("TEST_GATEWAY")
  isTestMode      Boolean  @default(true)
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  refund          Refund?
}

model Refund {
  id          String   @id @default(uuid())
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id])
  registrationId String   @unique
  registration Registration @relation(fields: [registrationId], references: [id])
  amount      Float
  reason      String
  status      String   @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, PROCESSED
  requestedAt DateTime @default(now())
  processedAt DateTime?
  createdAt   DateTime @default(now())
}

// ─── Submissions ───

model Submission {
  id              String   @id @default(uuid())
  title           String
  abstractText    String
  keywords        String?
  trackId         String?
  track           Track?   @relation(fields: [trackId], references: [id])
  participantId   String?
  participant     Participant? @relation(fields: [participantId], references: [id])
  status          String   @default("DRAFT") // DRAFT, SUBMITTED, SCREENING, UNDER_REVIEW, REVISION_REQUESTED, ACCEPTED, REJECTED, WITHDRAWN
  presentationType String? // ORAL, POSTER
  submittedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  authors         SubmissionAuthor[]
  files           SubmissionFile[]
  assignments      ReviewerAssignment[]
  reviews         Review[]
  decisions       EditorialDecision[]
  conflicts       ConflictDeclaration[]
  presentation    PresentationAssignment?
}

model SubmissionAuthor {
  id            String   @id @default(uuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  participantId String?
  participant    Participant? @relation(fields: [participantId], references: [id])
  name          String
  email         String
  affiliation   String?
  isCorresponding Boolean @default(false)
  order         Int      @default(0)
}

model SubmissionFile {
  id            String   @id @default(uuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileName      String
  filePath      String
  fileType      String   // ABSTRACT, FULL_PAPER, REVISION, CAMERA_READY
  fileSize      Int
  mimeType      String
  version       Int      @default(1)
  uploadedAt    DateTime @default(now())
}

// ─── Tracks ───

model Track {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  topics      String?  // Comma-separated topics
  guidelines  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  submissions Submission[]
}

// ─── Reviews ───

model ReviewerAssignment {
  id            String   @id @default(uuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String   // The reviewer's userId
  user         User     @relation(fields: [userId], references: [id])
  status        String   @default("ASSIGNED") // ASSIGNED, ACCEPTED, DECLINED, IN_PROGRESS, COMPLETED
  assignedAt    DateTime @default(now())
  dueDate       DateTime?
  review        Review?
}

model Review {
  id                String   @id @default(uuid())
  assignmentId     String   @unique
  assignment       ReviewerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId     String
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId           String   // The reviewer's userId
  user             User     @relation(fields: [userId], references: [id])
  // Scoring
  relevance         Int?  // 1-10
  originality       Int?
  methodology       Int?
  clarity           Int?
  technicalQuality  Int?
  overallScore      Int?
  strengths         String?
  weaknesses        String?
  requiredRevisions String?
  confidentialComments String?
  commentsForAuthor  String?
  recommendation    String?  // ACCEPT, MINOR_REVISION, MAJOR_REVISION, REJECT
  submittedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EditorialDecision {
  id            String   @id @default(uuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  decision      String   // ACCEPT, REJECT, REVISION_REQUESTED
  decidedBy     String
  decidedByName String
  comments      String?
  createdAt     DateTime @default(now())
}

model ConflictDeclaration {
  id            String   @id @default(uuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId        String
  reason        String
  declaredAt    DateTime @default(now())
}

// ─── Sessions & Programme ───

model Session {
  id          String   @id @default(uuid())
  day         Int      // Day 1, Day 2, etc.
  date        DateTime
  startTime   String
  endTime     String
  title       String
  description String?
  location    String?
  type        String   @default("TALK") // KEYNOTE, TALK, PANEL, BREAK, POSTER, WORKSHOP
  chairName   String?
  presentations PresentationAssignment[]
  createdAt   DateTime @default(now())
}

model PresentationAssignment {
  id            String   @id @default(uuid())
  submissionId  String   @unique
  submission    Submission @relation(fields: [submissionId], references: [id])
  sessionId     String?
  session       Session? @relation(fields: [sessionId], references: [id])
  slotTime      String?
  presentationOrder Int?
}

// ─── Attendance & Check-in ───

model Attendance {
  id            String   @id @default(uuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  sessionId     String?
  checkedInAt   DateTime?
  status        String   @default("NOT_CHECKED_IN") // NOT_CHECKED_IN, CHECKED_IN, CHECKED_OUT
  method        String?  // QR, MANUAL
  checkedInBy   String?
  createdAt     DateTime @default(now())
}

model Volunteer {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  email       String
  phone       String?
  role        String   @default("GENERAL") // GENERAL, REGISTRATION_DESK, SESSION_COORDINATOR, TECH_SUPPORT
  assignedDay Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Certificate {
  id              String   @id @default(uuid())
  certificateId   String   @unique // CERT-2026-001
  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id])
  registrationId  String?  @unique
  registration    Registration? @relation(fields: [registrationId], references: [id])
  type            String   // PARTICIPATION, PRESENTATION
  status          String   @default("PENDING") // PENDING, ELIGIBLE, ISSUED
  issuedAt        DateTime?
  overrideBy      String?
  overrideReason  String?
  createdAt       DateTime @default(now())
}

// ─── Notifications & Announcements ───

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactEnquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  isResolved Boolean @default(false)
  createdAt DateTime @default(now())
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  body      String
  variables String? // JSON string of variable names
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  body      String
  templateName String?
  isTestMode Boolean @default(true)
  status    String   @default("LOGGED") // LOGGED, SENT, FAILED
  createdAt DateTime @default(now())
}

// ─── Audit Log ───

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}
